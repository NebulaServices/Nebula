<script>
    import { EventHandler } from "@utils/events";
    import { SW, createProxyScripts, checkProxyScripts } from "@utils/serviceWorker";
    import { staticAssetLocation } from "@utils/staticAssetLocation";
    import { defaultStore } from "@utils/storage";
    import { Settings } from "@utils/settings";
    import { SettingsVals, resolveWispServer } from "@utils/values";
    import { log } from "@utils/index";
    import { Marketplace } from "@utils/marketplace";
    import { installMarketplaceBridge } from "@utils/marketplaceBridge";
    import { installProxyContext } from "@utils/proxyContext";
    import { CATALOG_ORIGIN, STATIC_MARKETPLACE } from "astro:env/client";
    import { BareCompatibleClient, type ProxyTransport } from "@mercuryworkshop/proxy-transports";
    import LibcurlClient from "@mercuryworkshop/libcurl-transport";
    import EpoxyClient from "@mercuryworkshop/epoxy-transport";
    const titleText = ` 
     _   _      _           _         ____                  _               
    | \\ | | ___| |__  _   _| | __ _  / ___|  ___ _ ____   _(_) ___ ___  ___ 
    |  \\| |/ _ \\ '_ \\| | | | |/ _' | \\___ \\ / _ \\ '__\\ \\ / / |/ __/ _ \\/ __|
    | |\\  |  __/ |_) | |_| | | (_| |  ___) |  __/ |   \\ V /| | (_|  __/\\__ \\
    |_| \\_|\\___|_.__/ \\__,_|_|\\__,_| |____/ \\___|_|    \\_/ |_|\\___\\___||___/
    `;
    const info = "Hello developer or curious individual & welcome to the console! \nThere isn't a whole lot here for you unless you have run into an error.";
    const sysInfo = `In which case please include the info below when opening the issue: \n\nOS: ${navigator.platform} \nBrowser: ${navigator.userAgent} \nService workers: ${"serviceWorker" in navigator ? "Yes" : "No"}`
    const init = async (): Promise<Marketplace> => {
        log({ type: 'normal', bg: false, prefix: false }, titleText);
        log({ type: 'normal', bg: true, prefix: false }, info);
        log({ type: 'normal', bg: true, prefix: false }, sysInfo);
        log({ type: 'info', bg: true, prefix: true }, "General init...");
        for (const script of createProxyScripts()) {
            let { promise, resolve, reject } = Promise.withResolvers();
            console.log(promise)
            script.addEventListener('load', () => {
                console.log(script.src)
                resolve(script.src);
            });
            script.addEventListener('error', () => {
                reject();
            });
            document.body.appendChild(script);
            await promise;
        }
        await checkProxyScripts();
        const sw = new SW();
        const { serviceWorker } = await sw.getSWInfo();
        const server = await defaultStore.getVal(SettingsVals.proxy.wispServer);
        const transportType = await defaultStore.getVal(SettingsVals.proxy.transport.key);
        // Resolve the wisp URL (the "generated" option validates a live
        // nightwisp endpoint; "default"/"custom" resolve synchronously).
        const wispUrl = await resolveWispServer(server);
        let transport: ProxyTransport;
        switch (transportType) {
            case 'epoxy':
                transport = new EpoxyClient({ wisp: wispUrl });
                break;
            case 'libcurl':
            default:
                transport = new LibcurlClient({ wisp: wispUrl });
                break;
        }
        window.client = new BareCompatibleClient(transport);
        if (STATIC_MARKETPLACE && CATALOG_ORIGIN) {
            const marketplaceClient = transportType === "epoxy"
                ? new BareCompatibleClient(new LibcurlClient({ wisp: wispUrl }))
                : window.client;
            installMarketplaceBridge(navigator.serviceWorker, marketplaceClient, CATALOG_ORIGIN);
            if (!navigator.serviceWorker.controller) {
                await new Promise<void>((resolve) => {
                    const timeout = setTimeout(resolve, 5000);
                    navigator.serviceWorker.addEventListener("controllerchange", () => {
                        clearTimeout(timeout);
                        resolve();
                    }, { once: true });
                });
                if (!navigator.serviceWorker.controller) {
                    if (!sessionStorage.getItem("nebula-marketplace-worker-reload")) {
                        sessionStorage.setItem("nebula-marketplace-worker-reload", "1");
                        location.reload();
                    }
                    throw new Error("Marketplace service worker did not take control");
                }
            }
            sessionStorage.removeItem("nebula-marketplace-worker-reload");
        }
        const mp = new Marketplace();
        window.controller = new $scramjetController.Controller({
          serviceworker: sw.getActiveWorker(),
          transport: transport,
          config: {
            scramjetPath: staticAssetLocation("/scram/scramjet.js", location.href),
            injectPath: staticAssetLocation("/scram-controller/controller.inject.js", location.href),
            wasmPath: staticAssetLocation("/scram/scramjet.wasm", location.href),
            // Custom rewrite prefix (was the default "/~/sj/" — a scramjet
            // fingerprint). The SW learns this via the controller's
            // registration message, so routing stays in sync.
            prefix: new URL(staticAssetLocation("/study/science/", location.href)).pathname,
            // Base32 (RFC 4648, no padding) URL codec. These functions are
            // serialized with .toString() into the injected frame scripts, so
            // they MUST be fully self-contained (only language + Web globals
            // like TextEncoder/TextDecoder/Uint8Array).
            codec: {
              encode: (url: string) => {
                if (!url) return url;
                const A = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
                const bytes = new TextEncoder().encode(url);
                let bits = 0, value = 0, out = "";
                for (let i = 0; i < bytes.length; i++) {
                  value = (value << 8) | bytes[i];
                  bits += 8;
                  while (bits >= 5) { out += A[(value >>> (bits - 5)) & 31]; bits -= 5; }
                }
                if (bits > 0) out += A[(value << (5 - bits)) & 31];
                return out;
              },
              decode: (encoded: string) => {
                if (!encoded) return encoded;
                const A = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
                const lookup: Record<string, number> = {};
                for (let i = 0; i < A.length; i++) lookup[A[i]] = i;
                let bits = 0, value = 0;
                const bytes: number[] = [];
                for (let i = 0; i < encoded.length; i++) {
                  const c = lookup[encoded[i]];
                  if (c === undefined) continue;
                  value = (value << 5) | c;
                  bits += 5;
                  if (bits >= 8) { bytes.push((value >>> (bits - 8)) & 255); bits -= 8; }
                }
                return new TextDecoder().decode(new Uint8Array(bytes));
              },
            },
          }
        });
        installProxyContext(window.controller);
        log({ type: 'info', bg: true, prefix: true }, `General init completed! \n\nServiceWorker: ${serviceWorker.active?.state}`);
        return mp;
    }
    
    const handleTheme = async (marketplace: Marketplace) => {
        const name = await marketplace.getValueFromStore(SettingsVals.marketPlace.appearance.theme.name);
        const payload = await marketplace.getValueFromStore(SettingsVals.marketPlace.appearance.theme.payload);
        const video = await marketplace.getValueFromStore(SettingsVals.marketPlace.appearance.video);
        const image = await marketplace.getValueFromStore(SettingsVals.marketPlace.appearance.image);
        if (name !== null) {
            marketplace.theme({
                type: 'normal',
                name: name,
                payload: payload,
                sources: {
                    video: video,
                    bg: image 
                }
            });
        }
    }

    const initSettings = async (marketplace: Marketplace) => {
        log({ type: 'info', bg: true, prefix: true }, "Initializing settings...");
        for await (const _ of Settings.initDefaults());
        await handleTheme(marketplace);
        log({ type: 'info', bg: true, prefix: true }, "Initialized Settings!");
    }

    const eventHandler = new EventHandler({
        events: {
            "DOMContentLoaded": async () => {
                const mp = await init();
                await initSettings(mp);
            }
        },
        logging: true 
    });
    //bind the events
    eventHandler.bind();
</script>
